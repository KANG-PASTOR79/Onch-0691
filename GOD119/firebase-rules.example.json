{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "god119-seminar": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID'",
        "currentSlide": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 65"
        },
        "pointer": {
          ".validate": "newData.hasChildren(['x','y','active','at']) && newData.child('x').isNumber() && newData.child('x').val() >= 0 && newData.child('x').val() <= 1 && newData.child('y').isNumber() && newData.child('y').val() >= 0 && newData.child('y').val() <= 1 && newData.child('active').isBoolean() && newData.child('at').isNumber()"
        },
        "strokes": {
          "$slide": {
            "$stroke": {
              ".validate": "newData.hasChildren(['id','tool','color','points','at']) && newData.child('id').isString() && newData.child('tool').isString() && newData.child('color').isString() && newData.child('at').isNumber() && newData.child('points').exists()"
            }
          }
        }
      }
    },
    "submissions": {
      "god119-seminar": {
        ".read": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "report": {
            ".write": "auth != null && auth.uid === $uid && newData.exists()",
            ".validate": "newData.hasChildren(['name','church','kind','fileName','at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 35"
            },
            "church": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 45"
            },
            "kind": {
              ".validate": "newData.isString() && (newData.val() === 'pdf' || newData.val() === 'image' || newData.val() === 'text' || newData.val() === 'mp4')"
            },
            "fileName": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now + 10000 && newData.val() >= now - 300000"
            },
            "$other": {
              ".validate": false
            }
          },
          "feedback": {
            ".write": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID' && newData.exists() && data.parent().child('report').exists()",
            ".validate": "newData.hasChildren(['kind','message','fileName','at'])",
            "kind": {
              ".validate": "newData.isString() && (newData.val() === 'received' || newData.val() === 'revise' || newData.val() === 'praise')"
            },
            "message": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 400"
            },
            "fileName": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140 && newData.val() === data.parent().child('report/fileName').val()"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 10000"
            },
            "$other": {
              ".validate": false
            }
          },
          "review": {
            ".write": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID' && newData.exists() && data.parent().child('report').exists()",
            ".validate": "newData.hasChildren(['checked','at'])",
            "checked": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now + 10000 && newData.val() >= now - 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID' && data.exists() && !newData.exists()"
      }
    },
    "attendance": {
      "god119-seminar": {
        ".read": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "profile": {
            ".write": "auth != null && auth.uid === $uid && newData.exists()",
            ".validate": "newData.hasChildren(['name','church','registeredAt','updatedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 35"
            },
            "church": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 45"
            },
            "registeredAt": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= now - 300000 && newData.val() <= now + 10000) || (data.exists() && newData.val() === data.val()))"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 10000"
            },
            "$other": {
              ".validate": false
            }
          },
          ".write": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID' && data.exists() && !newData.exists()"
        },
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_PRESENTER_UID' && data.exists() && !newData.exists()"
      }
    }
  }
}
